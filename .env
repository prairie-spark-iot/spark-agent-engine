# spark-agent-engine — Docker Compose environment variables
# docker compose reads .env from the same directory automatically.
# Uncomment and change any value as needed.

# ── Application ──
APP_PORT=8080

# ── JVM ──
JVM_XMS=2g
JVM_XMX=2g

# ── PostgreSQL ──
DB_URL=jdbc:postgresql://postgres:5432/spark_ai
DB_USER=root
DB_PASSWORD=root123456

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123456

# ── Kafka ──
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── MQTT ──
MQTT_HOST=emqx
MQTT_PORT=1883

# ── Resource Limits ──
APP_MEM_LIMIT=4G
APP_CPU_LIMIT=2

# ── Runtime ──
TZ=Asia/Shanghai
LOG_LEVEL=INFO
